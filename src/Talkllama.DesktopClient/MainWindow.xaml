<Window x:Class="Talkllama.DesktopClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Talkllama.DesktopClient"
        mc:Ignorable="d"
        Title="TalkLlama Voice Client" Height="450" Width="600"
        Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status & Title -->
        <TextBlock Text="🎙️ TalkLlama AI Assistant" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Push to Talk Button -->
        <Button x:Name="RecordButton" Grid.Row="1" Content="Hold to Speak" 
                FontSize="16" FontWeight="Bold" Foreground="White" Background="#007ACC" Height="60" 
                PreviewMouseDown="RecordButton_PreviewMouseDown" 
                PreviewMouseUp="RecordButton_PreviewMouseUp" Margin="0,0,0,15"/>

        <!-- Output Log / Transcript display -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="#252526" Padding="10">
            <TextBlock x:Name="OutputTextBlock" Foreground="#DCDCDC" TextWrapping="Wrap" FontSize="14" Text="Ready... Press and hold the button to record."/>
        </ScrollViewer>

        <!-- Dynamic Status Bar -->
        <StatusBar Grid.Row="3" Background="#007ACC" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusLabel" Text="Idle" Foreground="White" FontWeight="SemiBold"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
